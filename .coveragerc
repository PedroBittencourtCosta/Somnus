[run]
source =
    accounts
    core
    ethics
omit =
    */migrations/*
    */tests/*
    */__pycache__/*
    */apps.py
    */admin.py

[report]
show_missing = True
skip_empty = True
exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    if __name__ == .__main__.:
    raise NotImplementedError

[html]
directory = htmlcov
